        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-185" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" visible="0" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-173">
