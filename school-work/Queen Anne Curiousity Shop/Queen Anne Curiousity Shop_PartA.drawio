        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-177" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-172">
          <mxGeometry y="140" width="640" height="240" as="geometry" />
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-178" value="CUSTOMER to SALE" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-177">
          <mxGeometry width="160" height="240" as="geometry">
            <mxRectangle width="160" height="240" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-179" value="one mandatory to many optional&lt;br&gt;(1,1) to (0,N)&lt;br&gt;1:M" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-177">
          <mxGeometry x="160" width="160" height="240" as="geometry">
            <mxRectangle width="160" height="240" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-180" value="From SALE: A customer has to be involved to make a sale entity exist, or make a purchase so the minimum is 1. Also, only one customer is involved with that transaction, which is why the maximum is also 1." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-177">
          <mxGeometry x="320" width="160" height="240" as="geometry">
            <mxRectangle width="160" height="240" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-186" value="From CUSTOMER: Customers can be registered before make a purchase if they are new, so that is why the minimum is zero. Customers can also make multiple purchases which is why it&#39;s optional and many." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-177">
          <mxGeometry x="480" width="160" height="240" as="geometry">
            <mxRectangle width="160" height="240" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-181" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-172">
          <mxGeometry y="380" width="640" height="300" as="geometry" />
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-182" value="EMPLOYEE to SALE" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-181">
          <mxGeometry width="160" height="300" as="geometry">
            <mxRectangle width="160" height="300" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-183" value="one mandatory to many optional&lt;br&gt;(1,1) to (0,N)&lt;br&gt;1:M" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-181">
          <mxGeometry x="160" width="160" height="300" as="geometry">
            <mxRectangle width="160" height="300" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-184" value="From SALE: An employee must be involved to help create a sale entity by ringing up the purchase, so the minimum is one. Also, only one employee is needed to ring up the sale which is why the maximum is also one." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-181">
          <mxGeometry x="320" width="160" height="300" as="geometry">
            <mxRectangle width="160" height="300" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-187" value="From EMPLOYEE: There is a possibility that an employee has no sales, either they never make any, or that they are new. That is why this minimum value can be zero. An employee can also make multiple sales throughout their employment, hence the many for maximum." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-181">
          <mxGeometry x="480" width="160" height="300" as="geometry">
            <mxRectangle width="160" height="300" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-193" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-172">
          <mxGeometry y="680" width="640" height="300" as="geometry" />
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-194" value="SALE to SALE_ITEM" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-193">
          <mxGeometry width="160" height="300" as="geometry">
            <mxRectangle width="160" height="300" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-195" value="one mandatory to many mandatory&lt;br&gt;(1,1) to (1,N)&lt;br&gt;1:1..*&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-193">
          <mxGeometry x="160" width="160" height="300" as="geometry">
            <mxRectangle width="160" height="300" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-196" value="From SALE_ITEM: Every sale item has to exist in a sale, that&#39;s how it is created, and that&#39;s also why it is a weak entity. It requires a Sale entity to exist. This is why there is a minimum of one, and the maximum of one is because once attached to a sale it stays on that specific one." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-193">
          <mxGeometry x="320" width="160" height="300" as="geometry">
            <mxRectangle width="160" height="300" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-197" value="From SALE: Every sale has to have at least one sale item in the sale to exist hence the mandatory minimum of 1. The maximum of many is because multiple sale items can exist in a single sale entity." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-193">
          <mxGeometry x="480" width="160" height="300" as="geometry">
            <mxRectangle width="160" height="300" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-188" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-172">
          <mxGeometry y="980" width="640" height="330" as="geometry" />
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-189" value="ITEM to SALE_ITEM" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-188">
          <mxGeometry width="160" height="330" as="geometry">
            <mxRectangle width="160" height="330" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-190" value="one mandatory to many optional&lt;br&gt;(1,1) to (0,N)&lt;br&gt;1:M" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-188">
          <mxGeometry x="160" width="160" height="330" as="geometry">
            <mxRectangle width="160" height="330" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-191" value="From SALE_ITEM: Every sale item has to reference one item in the ITEM table. That is because this relation is between the actual inventory which represents what is available to sell. This specific relationship exists because you cannot sell something that you don&#39;t have, hence why the mandatory min and max is one." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-188">
          <mxGeometry x="320" width="160" height="330" as="geometry">
            <mxRectangle width="160" height="330" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-192" value="From ITEM: Items are added to the inventory before being sold, so that&#39;s why the minimum is zero, that represents items that are in stock and haven&#39;t sold at all. The maximum can be multiple because certain items can be sold multiple times which would have different sale items." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-188">
          <mxGeometry x="480" width="160" height="330" as="geometry">
            <mxRectangle width="160" height="330" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-198" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-172">
          <mxGeometry y="1310" width="640" height="260" as="geometry" />
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-199" value="VENDOR to ITEM" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-198">
          <mxGeometry width="160" height="260" as="geometry">
            <mxRectangle width="160" height="260" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-200" value="one mandatory to many optional&lt;br&gt;(1,1) to (0,N)&lt;br&gt;1:M" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-198">
          <mxGeometry x="160" width="160" height="260" as="geometry">
            <mxRectangle width="160" height="260" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-201" value="From ITEM: Every item has to be purchased from exactly one vendor, which is why the maximum is one. The minimum is one because items cannot exist without being purchased from a vendor." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-198">
          <mxGeometry x="320" width="160" height="260" as="geometry">
            <mxRectangle width="160" height="260" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="qUGOQLq7JY_qXNDhBrqQ-202" value="From VENDOR: A vendor can be in the system before the shop purchases any items from them, that is why the minimum is zero. The maximum is many because a vendor can offer and sell multiple items to the shop." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="qUGOQLq7JY_qXNDhBrqQ-198">
          <mxGeometry x="480" width="160" height="260" as="geometry">
            <mxRectangle width="160" height="260" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
